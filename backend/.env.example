# 配置模板：复制为 .env（开发）或 .env.production（生产）后填写真实值
APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=logs

# MySQL 连接串：mysql+pymysql://用户名:密码@主机:端口/库名?charset=utf8mb4
MYSQL_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/dengbao?charset=utf8mb4

# JWT 签名密钥：生成方式 python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# MinIO 对象存储（元数据与文件解耦：MySQL resources 存元数据，MinIO 存原文件）
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dengbao

# Qdrant 向量库（等保标准库 / 企业本地库 / 历史标书库，按 kb_type 分 collection）
QDRANT_URL=http://127.0.0.1:16333
QDRANT_COLLECTION=dengbao_kb

# 大模型（AI 三层：模型层 / 提示词层 / 记忆层）
DEEPSEEK_API_KEY=sk-xxx
DASHSCOPE_API_KEY=sk-xxx
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
RAG_TOP_K=5
MEMORY_WINDOW_K=20
